# ---------------------------------------------------------------------------
# RivalLens environment. Copy to .env.local and fill in real values.
# .env.local is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Browser-safe Supabase configuration (may be inlined into client bundles) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
# Modern browser-safe key (preferred). From Supabase > Project Settings > API keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback. Only needed if the publishable key above is not set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only configuration. NEVER expose these values to browser code. ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
# Modern server-only key (preferred). "Secret keys" in Project Settings > API keys.
SUPABASE_SECRET_KEY=
# Legacy fallback. Only needed if the secret key above is not set.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Hosted project (example shape for the authenticated smoke test):
#
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
#   SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
#   DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# ---------------------------------------------------------------------------
